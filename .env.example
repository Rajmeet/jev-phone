# Jev — one of the two. TypeSafe's API, or the Vercel AI Gateway (typesafe-ai/jev).
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
# JEV_PROVIDER=typesafe|vercel   (default: whichever key is set, TypeSafe first)
# JEV_MODEL=jev-latest

# Text helper for TYPE (OpenAI-compatible chat completions). Defaults to the
# gateway with Llama 4 Scout, reusing AI_GATEWAY_API_KEY when TEXT_MODEL_API_KEY is unset.
# TEXT_MODEL_API_KEY=
# TEXT_MODEL_BASE_URL=https://ai-gateway.vercel.sh/v1
# TEXT_MODEL=meta/llama-4-scout

# Where the phone is: connect (booted local simulator, default) | launch | cloud | <udid>
# JEV_PHONE_DEVICE=connect
# For cloud: eval "$(phone-use env <id>)" exports PHONE_USE_SANDBOX_URL and PHONE_USE_SANDBOX_TOKEN
